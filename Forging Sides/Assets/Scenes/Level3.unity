  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ceb0ac1d9b429d40821084fa6837710, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FirstDayTutorial
  steps:
  - message: 'The conflict has escalated beyond what we could have imagined, the
      weapons shortage has reached an all time high. Your Current objective is to
      maximise profit, the outcome of this war is irrelevant to us. '
    completeWhen: 0
    requiredItem: {fileID: 0}
    requiredCount: 0
    highlightTarget: {fileID: 0}
    startTutorialOrder: {fileID: 0}
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - message: 'Focus on incoming orders from both factions. You will need to be quick,
      hold Shift to sprint. '
    completeWhen: 1
    requiredItem: {fileID: 0}
    requiredCount: 0
    highlightTarget: {fileID: 0}
    startTutorialOrder: {fileID: 0}
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - message: 'Here''s your first customer. Every order will show at the top of your
      screen, you can complete an order by bringing it to the delivery desk at the
      front.   '
    completeWhen: 0
    requiredItem: {fileID: 0}
    requiredCount: 0
    highlightTarget: {fileID: 714998629}
    startTutorialOrder: {fileID: 11400000, guid: 845600de5ea8cdc458d39ee525ec1d1e, type: 2}
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - message: 'To make the sword you will need to smelt some copper. Press E at the
      "Raw Copper" box. '
    completeWhen: 2
    requiredItem: {fileID: 11400000, guid: 843bf084d83a7784ab590f684366fbac, type: 2}
    requiredCount: 0
    highlightTarget: {fileID: 177322610}
    startTutorialOrder: {fileID: 0}
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - message: Pick up the ore and drop it into the forge.
    completeWhen: 5
    requiredItem: {fileID: 11400000, guid: 843bf084d83a7784ab590f684366fbac, type: 2}
    requiredCount: 0
    highlightTarget: {fileID: 1256748781}
    startTutorialOrder: {fileID: 0}
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - message: 'The ore will take a few seconds to smelt, you can see if an ore is
      smelting by placing your cursor over the forge. '
    completeWhen: 6
    requiredItem: {fileID: 11400000, guid: 7009539e87d0ac941a47c2930e29db5f, type: 2}
    requiredCount: 0
    highlightTarget: {fileID: 1256748781}
    startTutorialOrder: {fileID: 0}
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - message: 'Take the ingot from the forge. '
    completeWhen: 3
    requiredItem: {fileID: 11400000, guid: 7009539e87d0ac941a47c2930e29db5f, type: 2}
    requiredCount: 0
    highlightTarget: {fileID: 1256748781}
